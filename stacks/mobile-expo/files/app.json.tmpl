{
  "expo": {
    "name": "{{title}}",
    "slug": "{{name}}",
    "scheme": "{{name}}",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "dev.hootl.{{pkg}}"
    },
    "android": {
      "package": "dev.hootl.{{pkg}}"
    },
    "web": {
      "output": "single"
    },
    "plugins": ["expo-router"],
    "experiments": {
      "typedRoutes": true
    }
  }
}

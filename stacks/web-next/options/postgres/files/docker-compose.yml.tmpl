# ローカルの PostgreSQL（この Mac からだけ繋がる）。起動: docker compose up -d  停止: docker compose down（データは volume に残る）
services:
  db:
    image: postgres:18-alpine
    environment:
      POSTGRES_USER: {{pkg}}
      POSTGRES_PASSWORD: {{pkg}}
      POSTGRES_DB: {{pkg}}
    ports:
      - "127.0.0.1:{{db_port}}:5432"
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U {{pkg}}"]
      interval: 2s
      timeout: 3s
      retries: 30
    volumes:
      # PostgreSQL 18 の公式イメージは /var/lib/postgresql/18/docker に置くので、親を volume にする
      - {{name}}-pgdata:/var/lib/postgresql
volumes:
  {{name}}-pgdata:
